{
  "schema": "dli-interface-inventory/1",
  "course": "cfx11",
  "validation_profile": [
    "assessment",
    "browser-course",
    "editable-code-cells",
    "markdown-course",
    "pyodide-kernel",
    "remote-model-client",
    "video-supplements"
  ],
  "discovery": {
    "html": "all",
    "mount_calls": "all",
    "markers": "all"
  },
  "factory_profiles": {},
  "marker_profiles": {
    "course-navigation": "course-navigation",
    "lesson-renderer": "markdown-lesson",
    "model-connection": "credential-controls",
    "runtime-workbench": "runtime-workbench"
  },
  "form_factors": {
    "course-navigation": {"states": ["ready", "current", "complete"], "authority": "none"},
    "credential-controls": {"states": ["empty", "running", "ready", "failed"], "authority": "learner-secret"},
    "editable-code-cell": {"states": ["ready", "queued", "running", "stopped", "succeeded", "failed", "reset"], "authority": "bounded-browser"},
    "markdown-lesson": {"states": ["loading", "ready", "failed"], "authority": "none"},
    "runtime-workbench": {"states": ["idle", "queued", "running", "stopped", "succeeded", "failed", "reset"], "authority": "bounded-browser"},
    "streaming-chat": {"states": ["ready", "running", "stopped", "succeeded", "failed"], "authority": "bounded-browser"},
    "video-supplement": {"states": ["preview", "loading", "playing", "failed"], "authority": "remote-media"}
  },
  "instance_templates": [
    {
      "id": "cfx11.python-cell",
      "source": "course.json",
      "kind": "course-code-cells",
      "form_factor": "editable-code-cell",
      "selector": ".xblock[data-cell-id]"
    },
    {
      "id": "cfx11.video-supplement",
      "source": "video-supplements.json",
      "kind": "video-entries",
      "form_factor": "video-supplement",
      "selector": ".lesson-video[data-video-id]"
    },
    {
      "id": "cfx11.browser-chat",
      "source": "course.json",
      "kind": "course-cell-id",
      "value": "3-Prompting-With-Messages/36-Chatbots:78",
      "form_factor": "streaming-chat",
      "selector": ".course-chat",
      "mount_probe": {
        "mode": "return-node",
        "module": "course.js",
        "export": "renderDisplay",
        "argument": {
          "type": "application/x-course-chat+json",
          "data": "{\"chat_id\":\"chat-1\"}"
        }
      }
    }
  ],
  "live_capabilities": ["assessment", "model-request", "model-stream"]
}
