# Browser-test runtime for the lab course pages.
# Holds Node.js, playwright-core, and Chromium in one image so host setup can be
# just Podman or Docker. The repo is bind-mounted read-only at runtime.
ARG PLAYWRIGHT_VERSION=1.55.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION

WORKDIR /opt/nemoclaw-runtime
RUN npm init -y \
    && npm install playwright-core@${PLAYWRIGHT_VERSION}

ENV NODE_PATH=/opt/nemoclaw-runtime/node_modules \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /workspace
ENTRYPOINT ["node", "scripts/test_page_runtime.js"]
