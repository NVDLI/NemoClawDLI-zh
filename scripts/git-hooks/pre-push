#!/usr/bin/env bash
# task1/scripts/git-hooks/pre-push — canonical content-gate pre-push hook.
#
# This is the layout-agnostic half of the pre-push contract and the copy that ships
# when task1/ is the repo root (the open-source release). It enforces:
#
#   RULE 2 — BASE GUARD: if origin/main is ahead, refuse with recovery commands.
#            A hook reports drift; it never rewrites contributor history.
#   RULE 3 — SKILL CONSISTENCY: refuse a push where a fact duplicated across files
#            diverged, or a SKILL.html points at a missing file.
#   RULE 4 — LAYOUT / LINK GLUE: deterministic surface-first layout + link validation,
#            reading the lab's real config so it cannot drift from what the lab serves.
#   RULE 5 — PROJECTION LINK GATE: replays how every written link compiles through the
#            deploy stack to a physical file or service; blocks on any ship-target break.
#
# The DLI serving wrapper (s-fx-43-v1) layers a repo-specific RULE 1 (repo lock) in
# .githooks/pre-push and then delegates here, so RULES 2-5 live in exactly one place.
# Install it (standalone repo): bash scripts/build/install-hooks.sh
set -euo pipefail

REMOTE="${1:-origin}"

# Resolve the content root from the installed hook. The repository root is canonical,
# while linked worktrees may place the hook through a shared Git directory.
T1="$(git rev-parse --show-toplevel)"
[ -d "$T1/task1/scripts" ] && T1="$T1/task1"

# ── RULE 2: base guard ───────────────────────────────────────────────────────
if [ "$REMOTE" = "origin" ]; then
    if ! git fetch origin main --quiet; then
        echo "pre-push: REFUSING PUSH - cannot verify origin/main."
        echo "Fix network or authentication, run 'git fetch origin main', then retry."
        exit 1
    fi

    LOCAL=$(git rev-parse HEAD)
    REMOTE_SHA=$(git rev-parse origin/main 2>/dev/null || true)

    if [ -n "$REMOTE_SHA" ] && [ "$LOCAL" != "$REMOTE_SHA" ]; then
        AHEAD=$(git rev-list HEAD..origin/main --count 2>/dev/null || echo 0)
        if [ "$AHEAD" -gt 0 ]; then
            echo "pre-push: REFUSING PUSH - origin/main is $AHEAD commit(s) ahead."
            echo "The hook will not rewrite history or choose conflict winners. Review the drift, then run:"
            echo "  git rebase origin/main"
            echo "Resolve deliberately, rerun the gates, then push again."
            exit 1
        fi
    fi
else
    echo "pre-push: remote '$REMOTE' is not origin; base comparison skipped, all repository gates still run."
fi

# ── RULE 2b: contribution safety contract ───────────────────────────────────
SAFETY="$T1/scripts/validation/contribution_safety_audit.py"
if [ -f "$SAFETY" ]; then
    if ! python3 "$SAFETY" --self-test || ! python3 "$SAFETY"; then
        echo ""
        echo "pre-push: REFUSING PUSH - contribution-safety contract failed."
        echo "The issue/PR intake, permission boundary, hook, CI, or release gate no longer matches policy."
        echo "Repair the named finding; this hook will not bypass or mutate it."
        exit 1
    fi
fi

# ── RULE 3: SKILL consistency guard ──────────────────────────────────────────
GUARD="$T1/scripts/skills/skill_consistency.py"
if [ -f "$GUARD" ]; then
    if ! python3 "$GUARD" --since origin/main; then
        echo ""
        echo "pre-push: REFUSING PUSH — SKILL consistency guard found a divergence."
        echo "A duplicated fact disagrees across files, or a SKILL.html points at a"
        echo "missing file. Each FAIL names the file; the change_impact map in that"
        echo "directory's SKILL.html lists what must move together. Fix, then push."
        exit 1
    fi
fi

# ── RULE 3b: SKILL contract conformance ──────────────────────────────────────
# Parity with RULE 3: where the consistency guard proves duplicated facts agree and paths
# resolve, this proves each skill-meta is a WELL-FORMED contract of its kind (classifies into a
# known kind, carries that kind's required keys, valid schema/node_type, semver, notebook status).
# A malformed beacon is what an agent samples and is misled by, so block the push. Drift (a beacon
# that no longer matches its directory) is advisory and surfaces in the gate, not here.
CONTRACT="$T1/scripts/skills/skill_contract.py"
if [ -f "$CONTRACT" ]; then
    if ! python3 "$CONTRACT"; then
        echo ""
        echo "pre-push: REFUSING PUSH — a SKILL contract is malformed."
        echo "A skill-meta does not classify into a known kind, drops a required key, or carries an"
        echo "invalid schema/node_type/version/status. Each FAIL names the SKILL and the field. See"
        echo "SKILL_CONTRACT.md, then run:  python3 scripts/skills/skill_contract.py"
        exit 1
    fi
fi

# ── RULE 3c: source and vendor-ingestion guard ───────────────────────────────
# The root license, contribution terms, internal-link sweep, and governed-material
# provenance all need to be clean before a source change leaves the workstation.
SOURCE_GATE="$T1/scripts/compliance/source_gate.py"
if [ -f "$SOURCE_GATE" ]; then
    if ! python3 "$SOURCE_GATE"; then
        echo ""
        echo "pre-push: REFUSING PUSH - source/vendor compliance gate failed."
        echo "Fix the private link, missing provenance, license, or contribution-term"
        echo "finding above. Policy: scripts/compliance/docs/vendor_policy.md"
        exit 1
    fi
fi
# ── RULE 3d: Python dependency vulnerability floor guard ─────────────────────
# Fast source-level SCA guard: query PyPI/OSV metadata for dependency floors and
# exact pins declared in requirements files and service Dockerfiles. Full transitive
# SCA still belongs in the built test/lab environment with pip-audit or OSV-Scanner.
DEPENDENCY_AUDIT="$T1/scripts/security/audit_python_dependencies.py"
if [ -f "$DEPENDENCY_AUDIT" ]; then
    if ! python3 "$DEPENDENCY_AUDIT"; then
        echo ""
        echo "pre-push: REFUSING PUSH - Python dependency vulnerability audit failed."
        echo "Raise the vulnerable floor/pin, then run:"
        echo "  python3 scripts/security/audit_python_dependencies.py"
        exit 1
    fi
fi


# ── RULE 3e: vulnerability waiver registry guard ────────────────────────────
# Any accepted vulnerability exception must be explicit, owned, sourced, and
# time-boxed. Expired waivers fail locally and in CI.
WAIVER_AUDIT="$T1/scripts/security/audit_vulnerability_waivers.py"
if [ -f "$WAIVER_AUDIT" ]; then
    if ! python3 "$WAIVER_AUDIT"; then
        echo ""
        echo "pre-push: REFUSING PUSH - vulnerability waiver registry failed."
        echo "Fix the expired or malformed waiver, then run:"
        echo "  python3 scripts/security/audit_vulnerability_waivers.py"
        exit 1
    fi
fi

# ── RULE 3f: release package determinism guard ───────────────────────────────
PACKAGE_RELEASE="$T1/scripts/build/package_release.py"
if [ -f "$PACKAGE_RELEASE" ]; then
    if ! python3 "$PACKAGE_RELEASE" --self-test; then
        echo ""
        echo "pre-push: REFUSING PUSH - release package determinism failed."
        echo "Run: python3 scripts/build/package_release.py --self-test"
        exit 1
    fi
fi

# ── RULE 4: layout / link glue guard ──────────────────────────────────────────
LAYOUT="$T1/scripts/validation/validate_layout.py"
if [ -f "$LAYOUT" ]; then
    if ! python3 "$LAYOUT" --quiet; then
        echo ""
        echo "pre-push: REFUSING PUSH — layout/link glue validation failed (see above)."
        echo "A course link is dead/cross/isolated, or a /sandbox/dli path the lab serves"
        echo "no longer exists on disk. Run:  python3 scripts/validation/validate_layout.py"
        exit 1
    fi
fi

# ── RULE 5: compilation-projection link gate (no live lab needed) ─────────────
BUNDLE="$T1/scripts/validation/validate_bundle.py"
if [ -f "$BUNDLE" ]; then
    if ! python3 "$T1/scripts/validation/learner_flow_audit.py" --self-test; then
        echo ""
        echo "pre-push: REFUSING PUSH - learner interaction validator mutation tests failed."
        echo "Repair the detector before trusting its progressive-disclosure, prerequisite, or lifecycle result."
        exit 1
    fi
    if ! python3 "$T1/scripts/build/assemble_locale_overlay.py" --self-test \
       || ! python3 "$T1/scripts/validation/localization_audit.py" --self-test \
       || ! python3 "$T1/scripts/validation/localization_audit.py" --locale pt-BR --no-write; then
        echo ""
        echo "pre-push: REFUSING PUSH - localization contract failed."
        echo "Repair the sparse overlay, pt-BR language finding, or reviewed source hash before pushing."
        exit 1
    fi
    # --no-write: gate only; the durable log is written by the cadence / CI / the
    # DGX-spark watcher, never by the hook (so a push never leaves a dirty tree).
    if ! python3 "$BUNDLE" --scope ship --no-write; then
        echo ""
        echo "pre-push: REFUSING PUSH — projection link gate found a SHIP-blocking issue."
        echo "A virtual link in a shipped page resolves to nothing, a redirect is dead, an"
        echo "asset crosses a course boundary, or a course links into another. The blocking"
        echo "items are listed above and in docs/validation/latest.md. Run:"
        echo "  python3 scripts/validation/validate_bundle.py --scope ship"
        exit 1
    fi
fi

# ── RULE 6: core-tenets projection present ────────────────────────────────────
# The operating creed (assumptions, practices, cadences, creeds) is projected into the
# root SKILL.html skill-meta instead of an agent-tool config file. Refuse a push that
# drops it, so the projection cannot silently rot out of the brain.
TENETS="$T1/scripts/validation/tenets.py"
if [ -f "$TENETS" ]; then
    if ! python3 "$TENETS" --check; then
        echo ""
        echo "pre-push: REFUSING PUSH — the core-tenets projection is missing from SKILL.html."
        echo "Regenerate it: python3 scripts/skills/gen_skill_hierarchy.py"
        exit 1
    fi
fi

# ── RULE 7: web module-graph integrity ────────────────────────────────────────
# Static ES-module import/export check (no browser, milliseconds): every page/module import
# resolves to a real export and every re-export is honest. Catches the class where a _shared.js
# extraction drops a re-export and importing pages break at load, the way glossary.html once lost
# glossaryScore. The render-time twin is scripts/runtime/render_check.py --all.
MODCHECK="$T1/scripts/runtime/module_check.py"
if [ -f "$MODCHECK" ]; then
    for d in web/nemoclaw web; do
        if [ -d "$T1/$d" ] && ! python3 "$MODCHECK" --dir "$T1/$d"; then
            echo ""
            echo "pre-push: REFUSING PUSH. The web module-graph integrity check failed (see above)."
            echo "An import names an export that no longer exists, or a re-export is dangling. Run:"
            echo "  python3 scripts/runtime/module_check.py"
            exit 1
        fi
    done
fi
exit 0
