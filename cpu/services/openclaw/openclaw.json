{
  "meta": {
    "lastTouchedVersion": "c-fx-15-llm-client-prefix-providers-1.0",
    "lastTouchedAt": "$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")"
  },
  "gateway": {
    "port": 8995,
    "bind": "lan",
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "trustedProxies": [
      "127.0.0.1",
      "10.200.0.0/16",
      "nginx",
      "172.18.0.0/16",
      "llm_client",
      "0.0.0.0/0"
    ],
    "controlUi": {
      "enabled": true,
      "basePath": "/lab/openclaw",
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true,
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "allowedOrigins": [
        "http://127.0.0.1:8088",
        "http://127.0.0.1:8996",
        "http://localhost:8088",
        "http://localhost:8996",
        "http://vk-devbox-llms-cpu-1.development.dli-infra.nvidia.com:8088",
        "http://vk-devbox-llms-cpu-1.development.dli-infra.nvidia.com:8996"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": { "enabled": true },
        "responses": { "enabled": true }
      }
    }
  },
  "wizard": {
    "lastRunAt": "2026-01-01T00:00:00.000Z",
    "lastRunVersion": "dli-openclaw-1.0",
    "lastRunCommand": "entrypoint",
    "lastRunMode": "local"
  },
  "update": {
    "checkOnStart": false
  },
  "models": {
    "mode": "merge",
    "providers": {
      "nim": {
        "baseUrl": "${NVIDIA_BASE_URL}",
        "apiKey": "not-needed-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "nim/nvidia/nemotron-3-super-120b-a12b",
            "name": "Nemotron 3 Super 120B",
            "reasoning": true,
            "cost": {
              "input": 0,
              "output": 0
            },
            "contextWindow": 256000,
            "maxTokens": 32000
          },
          {
            "id": "nim/nvidia/nemotron-3-nano-30b-a3b",
            "name": "Nemotron 3 Nano 30B",
            "reasoning": true,
            "cost": {
              "input": 0,
              "output": 0
            },
            "contextWindow": 128000,
            "maxTokens": 16000
          }
        ]
      },
      "deepseek-ai": {
        "baseUrl": "${NVIDIA_BASE_URL}",
        "apiKey": "not-needed-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-ai/deepseek-v4-pro",
            "name": "DeepSeek V4 Pro via llm_client",
            "reasoning": true,
            "cost": {
              "input": 0,
              "output": 0
            },
            "contextWindow": 128000,
            "maxTokens": 32000
          }
        ]
      },
      "moonshotai": {
        "baseUrl": "${NVIDIA_BASE_URL}",
        "apiKey": "not-needed-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "moonshotai/kimi-k2.6",
            "name": "Kimi K2.6 via llm_client",
            "reasoning": true,
            "cost": {
              "input": 0,
              "output": 0
            },
            "contextWindow": 256000,
            "maxTokens": 32000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "deepseek-ai/deepseek-v4-pro": {},
        "moonshotai/kimi-k2.6": {}
      },
      "model": {
        "primary": "deepseek-ai/deepseek-v4-pro",
        "fallbacks": [
          "moonshotai/kimi-k2.6"
        ]
      },
      "thinkingDefault": "adaptive",
      "sandbox": {
        "mode": "off"
      },
      "heartbeat": {
        "every": "0",
        "session": "heartbeat"
      },
      "maxConcurrent": 10,
      "subagents": {
        "maxChildrenPerAgent": 20,
        "maxSpawnDepth": 3,
        "runTimeoutSeconds": 1800,
        "maxConcurrent": 15,
        "thinking": "off"
      },
      "compaction": {
        "model": "moonshotai/kimi-k2.6",
        "notifyUser": true
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      }
    }
  },
  "plugins": {
    "allow": [],
    "entries": {
      "discord": { "enabled": false },
      "slack":   { "enabled": false }
    }
  },
  "diagnostics": {
    "enabled": false
  },
  "tools": {
    "profile": "full",
    "deny": [
      "discord:*",
      "whatsapp:*",
      "msteams:*"
    ],
    "sessions": {
      "visibility": "all"
    },
    "loopDetection": {
      "enabled": true,
      "historySize": 20,
      "warningThreshold": 4,
      "criticalThreshold": 8,
      "globalCircuitBreakerThreshold": 30,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      }
    },
    "exec": {
      "strictInlineEval": false,
      "security": "full",
      "ask": "off"
    }
  },
  "commands": {
    "allowFrom": {
      "webchat": [
        "*"
      ]
    }
  }
}
