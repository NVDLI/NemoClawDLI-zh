# Use this file to ignore anything you don't want built into the
# Docker image. It should ignore everything .gitignore does, as well
# as the .git directory itself, which can be large, and is not required inside
# the Docker image.

.git
.Trash*
**/.Trash*
**/.ipynb_checkpoints
**/__pycache__
**/.venv
**/.mypy_cache
**/.pytest_cache
**/.DS_Store
**/node_modules
**/.git
**/.gitignore
**/.idea
**/lost+found

# ── Secrets: never send to the build daemon or bake into the image ──
.env
.env-*
.secret
**/.secret

# ── Agent-only / staging dirs not needed in the lab image ──
.solution
.exec_stage

# ── Generated browser-course bundles (regenerated by bundle_standalone.py) ──
**/web_standalone
**/nemoclaw_standalone
**/current-html-pages.zip